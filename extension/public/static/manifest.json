{
  "manifest_version": 3,
  "name": "memory404",
  "description": "Save current tab to memory404 groups.",
  "version": "0.1.1",
  "action": {
    "default_title": "Save Link"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["remember-hover.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "omnibox": {
    "keyword": "lk"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Option+Shift+L"
      },
      "description": "Open memory404 save overlay"
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "tabGroups",
    "scripting",
    "storage",
    "omnibox",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://localhost:3000/*",
    "https://memory404.vercel.app/*",
    "https://*.vercel.app/*",
    "https://*.onrender.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
