# Session signing secret — server-only. Generate with: openssl rand -base64 32
SESSION_SECRET=your_random_session_secret

# Resend (password-reset emails) — server-only. https://resend.com
RESEND_API_KEY=your_resend_api_key
# Verified sender for production (defaults to Resend sandbox onboarding@resend.dev)
# EMAIL_FROM="memory404 <noreply@yourdomain.com>"

# Dev only: skip the page login gate. Ignored when NODE_ENV=production.
# AUTH_BYPASS=1

# API base URL — Render backend in production; leave empty for same-origin /api (local Next.js)
NEXT_PUBLIC_API_URL=

# Page screenshots: Microlink → thum.io → mShots (validated). Optional override:
# SCREENSHOT_URL_TEMPLATE=https://image.thum.io/get/width/1200/noanimate/{url}

# MongoDB Atlas — server-only. URL-encode special characters in the password.
MONGODB_URI="mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="memory404"
